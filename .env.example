# Salesforce org alias authorised in the sf CLI (read-only by default)
SF_ORG=prod
# Global kill-switch. 1 = people listed in data/access.json may push to Salesforce; 0 = nobody can
ALLOW_WRITE=0
# Set to 1 to force the built-in demo account (no Salesforce needed)
DEMO=0
# Enrichment providers (optional)
ZOOMINFO_JWT=
LUSHA_API_KEY=

# --- Security ---
# The server listens on this computer only. To let other machines in, set HOST=0.0.0.0 AND put the app behind HTTPS
# (a reverse proxy); sign-in cookies are then marked Secure automatically. A one-time setup code is printed in the
# terminal for creating the first account from another machine.
# HOST=127.0.0.1
# PORT=8787
# DATA_DIR=./data
